{
  "manifest_version": 3,
  "name": "FlowStudio Local Bridge",
  "version": "4.0.0",
  "description": "High-speed local GPU reverse-alpha and neural upscaling media bridge for FlowStudio.",
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "nativeMessaging",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://flowstudio-api.flowstudio-app.workers.dev/*",
    "https://flow.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "content_flow.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlowStudio Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
